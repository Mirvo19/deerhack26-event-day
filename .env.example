# ---- DeerHack Live env (local dev: copy to .env | Vercel: add as env vars) ----
# Supabase project (dashboard > Project Settings > API)
SUPABASE_URL=https://xyzcompany.supabase.co
# Public anon key — safe client-side. Display page gets ONLY this + SUPABASE_URL.
SUPABASE_ANON_KEY=eyJ...anon...key
# Service-role key — SERVER-ONLY (Vercel env vars, never exposed). Flask writes + uploads.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...key

# Signs the stateless admin cookie (dh_admin) + debounce cookies. Long random string.
SECRET_KEY=change-me-to-a-long-random-string
ENV=development
# Comma-separated deploy origins allowed for credentialed admin API calls.
ALLOWED_ORIGIN=http://localhost:5000
PORT=5000
